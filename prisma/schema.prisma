generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  CUSTOMER
  BUSINESS
}

enum PromotionKind {
  PLATFORM_VOUCHER
  STORE_ANNOUNCEMENT
}

enum ClaimStatus {
  CLAIMED
  REDEEMED
  EXPIRED
}

enum Industry {
  BAKERY_CAFE
  SUPERMARKET_CONVENIENCE
}

enum DealType {
  PERCENT_OFF
  FIXED_AMOUNT_OFF
  BOGO
  FREEBIE
  OTHER
}

enum NotificationType {
  NEW_ORDER
  NEW_MESSAGE
}

model ProductCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  emoji     String?
  industry  Industry?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  boxes Box[]
}

model User {
  id        String      @id @default(uuid())
  email     String?     @unique
  name      String
  phone     String?     @unique
  role      AccountRole @default(CUSTOMER)
  avatar    String?
  address   String?
  createdAt DateTime    @default(now())

  orders        Order[]
  reviews       Review[]
  stores        Store[]
  voucherClaims VoucherClaim[]
  messages      Message[]
  notifications Notification[]
  conversations Conversation[]
}

model Store {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  address     String
  phone       String?  @unique
  openHours   String?
  lat         Float?
  lng         Float?
  logo        String?
  description String?
  verified    Boolean  @default(false)
  industry    Industry @default(BAKERY_CAFE)
  createdAt   DateTime @default(now())

  owner      User        @relation(fields: [ownerId], references: [id])
  boxes      Box[]
  orders     Order[]
  reviews    Review[]
  promotions Promotion[]
  conversations Conversation[]

  @@unique([name, address])
}

model Box {
  id              String   @id @default(uuid())
  storeId         String
  name            String
  description     String?
  priceOriginal   Int
  priceSale       Int
  quantityTotal   Int
  quantityLeft    Int
  pickupStart     String
  pickupEnd       String
  date            DateTime
  image           String?
  categoryId      String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  store      Store           @relation(fields: [storeId], references: [id])
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  storeId       String
  status        OrderStatus @default(PENDING)
  total         Int
  paymentMethod String      @default("cash")
  pickupCode    String      @unique @default(cuid())
  createdAt     DateTime    @default(now())
  pickedUpAt    DateTime?

  user  User        @relation(fields: [userId], references: [id])
  store Store       @relation(fields: [storeId], references: [id])
  items OrderItem[]
  review Review?
  notifications Notification[]
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  boxId       String
  quantity    Int
  priceAtTime Int

  order Order @relation(fields: [orderId], references: [id])
  box   Box   @relation(fields: [boxId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  CANCELLED
}

model Promotion {
  id            String        @id @default(cuid())
  storeId       String
  kind          PromotionKind
  title         String
  description   String?
  image         String?
  dealType      DealType?
  discountValue Int?
  validFrom     DateTime
  validUntil    DateTime
  totalCodes    Int?
  claimedCount  Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  store  Store          @relation(fields: [storeId], references: [id])
  claims VoucherClaim[]
}

model VoucherClaim {
  id          String      @id @default(cuid())
  promotionId String
  userId      String
  code        String      @unique
  status      ClaimStatus @default(CLAIMED)
  claimedAt   DateTime    @default(now())
  redeemedAt  DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([promotionId, userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  messages Message[]

  @@unique([userId, storeId])
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  senderId        String
  body            String    @default("")
  attachmentUrl   String?   // legacy single-attachment field, kept for messages sent before multi-attachment support
  attachmentType  String?   // "image" | "file"
  attachmentName  String?
  attachments     Json?     // ChatAttachment[] (see lib/chatAttachments.ts) — multi-file sends
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User          @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  orderId        String?
  conversationId String?
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, readAt])
}
